  volume = {4},
  number = {1},
  pages = {e28-e40},
  issn = {24682667},
  doi = {10.1016/S2468-2667(18)30202-0},
  urldate = {2025-06-17},
  abstract = {Background Low emission zones (LEZ) are an increasingly common, but unevaluated, intervention aimed at improving urban air quality and public health. We investigated the impact of London's LEZ on air quality and children's respiratory health.},
