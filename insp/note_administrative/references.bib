@article{mudwayImpactLondonsLow2019,
  title = {Impact of {{London}}'s Low Emission Zone on Air Quality and Children's Respiratory Health: A Sequential Annual Cross-Sectional Study},
  shorttitle = {Impact of {{London}}'s Low Emission Zone on Air Quality and Children's Respiratory Health},
  author = {Mudway, Ian S and Dundas, Isobel and Wood, Helen E and Marlin, Nadine and Jamaludin, Jeenath B and Bremner, Stephen A and Cross, Louise and Grieve, Andrew and Nanzer, Alex and Barratt, Ben M and Beevers, Sean and Dajnak, David and Fuller, Gary W and Font, Anna and Colligan, Grainne and Sheikh, Aziz and Walton, Robert and Grigg, Jonathan and Kelly, Frank J and Lee, Tak H and Griffiths, Chris J},
  year = {2019},
